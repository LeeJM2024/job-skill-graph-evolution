{
  "name": "job-update-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Company and government job update system.",
  "scripts": {
    "company:cli": "cd job_update\\company_job_update && python -m core.cli",
    "government:cli": "cd job_update && python -m government_job_update.cli",
    "extract:job-skills-api": "python job_update/company_job_update/skill_extract/extract_job_skills_api.py",
    "extract:job-skills-deepseek": "python job_update/company_job_update/skill_extract/extract_job_skills_api.py --provider deepseek",
    "extract:job-skills-gpt": "python job_update/company_job_update/skill_extract/extract_job_skills_api.py --provider gpt",
    "normalize:job-skills": "python job_update/company_job_update/skill_extract/normalize_extracted_skills.py",
    "test:job-update": "python -m pytest job_update/company_job_update/tests job_update/government_job_update/tests -q",
    "web:job-update": "python -m uvicorn backend.app:app --host 127.0.0.1 --port 8787 --app-dir web_app"
  }
}
